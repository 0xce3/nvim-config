#!/usr/bin/env bash
set -euo pipefail

# Native pane scrollbars require tmux 3.6. Keep the release and digest pinned.
version=3.6
sha256=136db80cfbfba617a103401f52874e7c64927986b65b1b700350b6058ad69607

version_is_supported() {
  command -v tmux >/dev/null 2>&1 || return 1
  local current major minor
  current="$(tmux -V)"
  current="${current#tmux }"
  IFS=. read -r major minor _ <<< "$current"
  minor="${minor%%[!0-9]*}"
  [[ "$major" =~ ^[0-9]+$ && "$minor" =~ ^[0-9]+$ ]] || return 1
  (( major > 3 || (major == 3 && minor >= 6) ))
}

if [[ "${1:-}" == --check ]]; then
  version_is_supported
  exit $?
fi
version_is_supported && exit 0

if [[ "$EUID" -ne 0 ]]; then
  exec sudo bash "$0" "$@"
fi

if command -v apt-get >/dev/null 2>&1; then
  apt-get update
  apt-get install -y build-essential pkg-config libevent-dev libncurses-dev bison curl tar gzip
elif command -v apk >/dev/null 2>&1; then
  apk add --no-cache build-base pkgconf libevent-dev ncurses-dev bison curl tar gzip
elif command -v dnf >/dev/null 2>&1; then
  dnf install -y gcc make pkgconf-pkg-config libevent-devel ncurses-devel bison curl tar gzip
else
  printf 'Install tmux %s or newer with your package manager.\n' "$version" >&2
  exit 1
fi

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
archive="$temporary/tmux.tar.gz"
curl -fL --retry 3 -o "$archive" "https://github.com/tmux/tmux/releases/download/$version/tmux-$version.tar.gz"
printf '%s  %s\n' "$sha256" "$archive" | sha256sum --check -
tar -xzf "$archive" -C "$temporary"
(
  cd "$temporary/tmux-$version"
  ./configure --prefix=/usr/local
)
make -C "$temporary/tmux-$version" -j2
make -C "$temporary/tmux-$version" install
hash -r
version_is_supported
