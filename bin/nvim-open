#!/usr/bin/env bash
set -euo pipefail

source_file="${1:-}"
[[ -n "$source_file" ]] || { printf 'No file selected\n' >&2; exit 1; }
source_file="$(realpath "$source_file")"
[[ -f "$source_file" ]] || { printf 'Not a file: %s\n' "$source_file" >&2; exit 1; }

open_windows() {
  command -v powershell.exe >/dev/null 2>&1 || {
    printf 'powershell.exe is required to open files on Windows\n' >&2
    return 1
  }
  command -v wslpath >/dev/null 2>&1 || {
    printf 'wslpath is required to open files on Windows\n' >&2
    return 1
  }

  local windows_path
  windows_path="$(wslpath -w "$1")"
  powershell.exe -NoProfile -Command 'Start-Process -LiteralPath $args[0]' "$windows_path" >/dev/null
}

if [[ "${DEVCONTAINER:-}" != "true" ]]; then
  open_windows "$source_file"
  exit
fi

workspace="${NVIM_DEV_CONTAINER_WORKSPACE:-}"
[[ -n "$workspace" && -d "$workspace/.git" ]] || {
  printf 'Opening Windows files requires a Git workspace started through nvim-dev\n' >&2
  exit 1
}

request_dir="$workspace/.git/nvim-download"
request_id="$(date +%s%N)-$$-$RANDOM"
request="$request_dir/$request_id.open-request"
response="$request_dir/$request_id.open-response"
mkdir -p "$request_dir"
printf '%s\n' "$source_file" > "$request.tmp"
mv "$request.tmp" "$request"

for _ in $(seq 1 100); do
  if [[ -f "$response" ]]; then
    result="$(cat "$response")"
    rm -f "$response"
    if [[ "$result" == ERROR:* ]]; then
      printf '%s\n' "${result#ERROR:}" >&2
      exit 1
    fi
    exit 0
  fi
  sleep 0.1
done

rm -f "$request"
printf 'Windows open bridge did not respond\n' >&2
exit 1
