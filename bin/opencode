#!/usr/bin/env bash
set -euo pipefail

real_opencode="${OPENCODE_REAL_BIN:-$HOME/.opencode/bin/opencode}"

if [[ ! -x "$real_opencode" ]]; then
  printf 'opencode wrapper: real opencode binary not found: %s\n' "$real_opencode" >&2
  exit 127
fi

project_root() {
  local dir
  dir="$(cd "${1:-.}" 2>/dev/null && pwd -P)" || return 1
  while [[ "$dir" != / ]]; do
    if [[ -f "$dir/.devcontainer/devcontainer.json" || -f "$dir/devcontainer.json" || -d "$dir/.git" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  printf '%s\n' "$(cd "${1:-.}" && pwd -P)"
}

has_devcontainer() {
  [[ -f "$1/.devcontainer/devcontainer.json" || -f "$1/devcontainer.json" ]]
}

choose_mode() {
  if [[ "${OPENCODE_DEV_DEFAULT:-}" == "local" || "${OPENCODE_DEV_DEFAULT:-}" == "remote" ]]; then
    printf '%s\n' "$OPENCODE_DEV_DEFAULT"
    return 0
  fi
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 2 ]]; then
    local choice
    choice="$(printf 'remote\tuse devcontainer\nlocal\tuse WSL host\n' | fzf \
      --ansi --height=8 --layout=reverse --border=rounded \
      --prompt='opencode mode> ' --with-nth=1,2 --delimiter='\t' | cut -f1 || true)"
    [[ "$choice" == "remote" || "$choice" == "local" ]] && { printf '%s\n' "$choice"; return 0; }
  fi
  printf '%b' '? opencode mode [remote/local] (default: remote): ' >&2
  local answer
  read -r answer
  case "${answer,,}" in
    l|local) printf 'local\n' ;;
    *) printf 'remote\n' ;;
  esac
}

if [[ "${1:-}" == "." ]]; then
  root="$(project_root ".")"
  if has_devcontainer "$root"; then
    mode="$(choose_mode)"
    if [[ "$mode" == "remote" ]]; then
      auth_file="$HOME/.local/share/opencode/auth.json"
      mount_arg=()
      if [[ -f "$auth_file" ]]; then
        mount_arg=(--mount "type=bind,source=$auth_file,target=/tmp/opencode-auth.json,readonly")
      else
        printf 'opencode wrapper: WSL auth file not found: %s\n' "$auth_file" >&2
      fi
      if command -v devcontainer >/dev/null 2>&1; then
        devcontainer up --workspace-folder "$root" "${mount_arg[@]}"
        if [[ -f "$auth_file" ]]; then
          devcontainer exec --workspace-folder "$root" sh -lc \
            'mkdir -p "$HOME/.local/share/opencode" && ln -sfn /tmp/opencode-auth.json "$HOME/.local/share/opencode/auth.json"'
        fi
        exec devcontainer exec --workspace-folder "$root" opencode "${@:2}"
      elif command -v npx >/dev/null 2>&1; then
        npx -y @devcontainers/cli up --workspace-folder "$root" "${mount_arg[@]}"
        if [[ -f "$auth_file" ]]; then
          npx -y @devcontainers/cli exec --workspace-folder "$root" sh -lc \
            'mkdir -p "$HOME/.local/share/opencode" && ln -sfn /tmp/opencode-auth.json "$HOME/.local/share/opencode/auth.json"'
        fi
        exec npx -y @devcontainers/cli exec --workspace-folder "$root" opencode "${@:2}"
      else
        printf 'opencode wrapper: devcontainer CLI not found\n' >&2
        exit 127
      fi
    fi
  fi
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
if [[ -z "${OPENCODE_PORT:-}" ]]; then
  root_hash="$(printf '%s' "$root" | cksum | awk '{print $1}')"
  export OPENCODE_PORT=$((4100 + root_hash % 10000))
fi
export OPENCODE_SERVER_URL="${OPENCODE_SERVER_URL:-http://127.0.0.1:${OPENCODE_PORT}}"

has_port=0
has_hostname=0
for arg in "$@"; do
  case "$arg" in
    --port|--port=*) has_port=1 ;;
    --hostname|--hostname=*) has_hostname=1 ;;
  esac
done

args=()
if [[ "$has_port" -eq 0 ]]; then
  args+=(--port "${OPENCODE_PORT:-4096}")
fi
if [[ "$has_hostname" -eq 0 ]]; then
  args+=(--hostname "${OPENCODE_HOSTNAME:-0.0.0.0}")
fi

exec "$real_opencode" "${args[@]}" "$@"
