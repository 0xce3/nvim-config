#!/usr/bin/env bash
set -euo pipefail

real_opencode="${OPENCODE_REAL_BIN:-$HOME/.opencode/bin/opencode}"

if [[ ! -x "$real_opencode" ]]; then
  printf 'opencode wrapper: real OpenCode binary not found: %s\n' "$real_opencode" >&2
  exit 127
fi

# OpenCode V2 manages its background service itself.  V1's --port and
# --hostname flags are no longer accepted by the terminal client.
exec "$real_opencode" "$@"
