#!/usr/bin/env bash
set -euo pipefail

target="${1:-.}"

if [[ -t 2 && "${NO_COLOR:-}" == "" ]]; then
  c_reset=$'\033[0m'
  c_dim=$'\033[2m'
  c_red=$'\033[31m'
  c_green=$'\033[32m'
  c_yellow=$'\033[33m'
  c_blue=$'\033[34m'
  c_magenta=$'\033[35m'
  c_cyan=$'\033[36m'
  c_bold=$'\033[1m'
else
  c_reset= c_dim= c_red= c_green= c_yellow= c_blue= c_magenta= c_cyan= c_bold=
fi

log() { printf '%b\n' "$*" >&2; }
banner() { log "${c_cyan}${c_bold}╭─ nvim-dev${c_reset} ${c_dim}containerized editor uplink${c_reset}"; }
step() { log "${c_blue}▸${c_reset} ${c_bold}$1${c_reset}${2:+ ${c_dim}$2${c_reset}}"; }
ok() { log "${c_green}✓${c_reset} $1${2:+ ${c_dim}$2${c_reset}}"; }
warn() { log "${c_yellow}!${c_reset} $1${2:+ ${c_dim}$2${c_reset}}"; }
info() { log "${c_magenta}λ${c_reset} $1${2:+ ${c_dim}$2${c_reset}}"; }
die() { log "${c_red}✗${c_reset} ${c_bold}nvim-dev:${c_reset} $*"; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

real_nvim() {
  if [[ -n "${NVIM_REAL_BIN:-}" && -x "${NVIM_REAL_BIN:-}" ]]; then
    printf '%s\n' "$NVIM_REAL_BIN"
    return 0
  fi

  local candidate
  IFS=: read -ra path_entries <<< "$PATH"
  for candidate_dir in "${path_entries[@]}"; do
    candidate="$candidate_dir/nvim"
    if [[ -x "$candidate" && "$candidate" != "$HOME/.local/bin/nvim" && "$candidate" != "$HOME/.config/nvim/bin/nvim" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

install_host_wrappers() {
  local user_bin="$HOME/.local/bin"
  mkdir -p "$user_bin"

  cat > "$user_bin/nvim-dev" <<'SH'
#!/usr/bin/env bash
exec "$HOME/.config/nvim/bin/nvim-dev" "$@"
SH
  chmod +x "$user_bin/nvim-dev"

  cat > "$user_bin/nvim" <<'SH'
#!/usr/bin/env bash
exec "$HOME/.config/nvim/bin/nvim" "$@"
SH
  chmod +x "$user_bin/nvim"

  cat > "$user_bin/opencode" <<'SH'
#!/usr/bin/env bash
exec "$HOME/.config/nvim/bin/opencode" "$@"
SH
  chmod +x "$user_bin/opencode"
}

devcontainer_cmd() {
  if command -v devcontainer >/dev/null 2>&1; then
    printf 'devcontainer\n'
  elif command -v npx >/dev/null 2>&1; then
    printf 'npx -y @devcontainers/cli\n'
  else
    die "missing devcontainer CLI; install with: npm install -g @devcontainers/cli"
  fi
}

quote() {
  printf '%q' "$1"
}

nvim_remote_expr() {
  local addr="$1" expr="$2"
  local nvim_bin
  nvim_bin="$(real_nvim)" || die "real nvim binary not found"
  if command -v timeout >/dev/null 2>&1; then
    timeout 2s "$nvim_bin" --server "$addr" --remote-expr "$expr" >/dev/null 2>&1
  else
    "$nvim_bin" --server "$addr" --remote-expr "$expr" >/dev/null 2>&1
  fi
}

project_root() {
  local dir
  dir="$(cd "$target" 2>/dev/null && pwd -P)" || die "not a directory: $target"
  while [[ "$dir" != / ]]; do
    if [[ -f "$dir/.devcontainer/devcontainer.json" || -f "$dir/devcontainer.json" || -d "$dir/.git" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  cd "$target" && pwd -P
}

has_devcontainer() {
  [[ -f "$root/.devcontainer/devcontainer.json" || -f "$root/devcontainer.json" ]]
}

devcontainer_json() {
  if [[ -f "$root/.devcontainer/devcontainer.json" ]]; then
    printf '%s\n' "$root/.devcontainer/devcontainer.json"
  else
    printf '%s\n' "$root/devcontainer.json"
  fi
}

devcontainer_json_value() {
  local key="$1"
  python3 - "$(devcontainer_json)" "$key" <<'PY'
import json, sys

def strip_jsonc(text):
    out = []
    i = 0
    in_string = False
    while i < len(text):
        if in_string:
            out.append(text[i])
            if text[i] == "\\" and i + 1 < len(text):
                i += 1
                out.append(text[i])
            elif text[i] == '"':
                in_string = False
        elif text[i] == '"':
            in_string = True
            out.append(text[i])
        elif text[i:i + 2] == "//":
            i = text.find("\n", i)
            if i == -1:
                break
            out.append("\n")
        elif text[i:i + 2] == "/*":
            i = text.find("*/", i + 2)
            if i == -1:
                raise ValueError("unterminated JSONC comment")
            i += 1
        else:
            out.append(text[i])
        i += 1
    return "".join(out)

with open(sys.argv[1], "r", encoding="utf-8") as f:
    value = json.loads(strip_jsonc(f.read())).get(sys.argv[2], "")
if isinstance(value, str):
    print(value)
PY
}

container_workspace() {
  local container="$1"
  local root_name env_ws json_ws label_ws
  root_name="$(basename "$root")"

  env_ws="$(docker exec "$container" sh -lc 'printf "%s" "${NVIM_WORKSPACE:-}"' 2>/dev/null || true)"
  if [[ -n "$env_ws" ]] && docker exec "$container" test -d "$env_ws" 2>/dev/null; then
    printf '%s\n' "$env_ws"
    return 0
  fi

  json_ws="$(devcontainer_json_value workspaceFolder || true)"
  if [[ -n "$json_ws" ]]; then
    printf '%s\n' "$json_ws"
    return 0
  fi

  label_ws="$(docker inspect -f '{{ index .Config.Labels "devcontainer.workspace_folder" }}' "$container" 2>/dev/null || true)"
  if [[ -n "$label_ws" && "$label_ws" != "<no value>" ]]; then
    printf '%s\n' "$label_ws"
    return 0
  fi

  local mount_dest
  mount_dest="$(docker inspect -f '{{ range .Mounts }}{{ if eq .Source "'"$root"'" }}{{ .Destination }}{{ "\n" }}{{ end }}{{ end }}' "$container" 2>/dev/null | head -n1 || true)"
  if [[ -n "$mount_dest" ]]; then
    printf '%s\n' "$mount_dest"
    return 0
  fi

  printf '/workspaces/%s\n' "$root_name"
}

container_host() {
  local container="$1"
  local network_json
  network_json="$(docker inspect -f '{{json .NetworkSettings.Networks}}' "$container")"
  if printf '%s' "$network_json" | grep -q '"host"'; then
    printf '127.0.0.1\n'
    return 0
  fi
  local ip
  ip="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$container")"
  [[ -n "$ip" ]] || die "could not determine container IP for $container"
  printf '%s\n' "$ip"
}

choose_container() {
  local containers
  containers="${1:-$(docker ps --format '{{.Names}}\t{{.Image}}\t{{.Status}}')}"
  [[ -n "$containers" ]] || die "no containers"

  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "$containers" | fzf --prompt='Attach container> ' | cut -f1
    return 0
  fi

  log "Matching containers:"
  local i=0 names=()
  while IFS=$'\t' read -r name image status; do
    i=$((i + 1))
    names+=("$name")
    log "  $i) $name  $image  $status"
  done <<< "$containers"
  printf 'Select container: ' >&2
  local choice
  read -r choice
  [[ "$choice" =~ ^[0-9]+$ ]] || die "invalid selection"
  printf '%s\n' "${names[$((choice - 1))]}"
}

project_containers() {
  local root_name image_name
  root_name="$(basename "$root")"
  image_name="vsc-${root_name//-/_}"

  docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}' | while IFS=$'\t' read -r name image status; do
    if docker inspect -f '{{ range .Mounts }}{{ .Source }} {{ end }}' "$name" 2>/dev/null | grep -Fq "$root"; then
      printf '%s\t%s\t%s\n' "$name" "$image" "$status"
    elif [[ "$image" == "$image_name"* ]]; then
      printf '%s\t%s\t%s\n' "$name" "$image" "$status"
    fi
  done
}

find_devcontainer_container() {
  local containers count
  containers="$(project_containers)"
  [[ -n "$containers" ]] || return 0

  count="$(printf '%s\n' "$containers" | wc -l)"
  if [[ "$count" -eq 1 ]]; then
    printf '%s\n' "$containers" | cut -f1
    return 0
  fi

  choose_container "$containers"
}

ensure_devcontainer_running() {
  # WSLg can expose the real socket outside XDG_RUNTIME_DIR. Existing
  # devcontainers retain the original bind source, so restore that path.
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local wayland_socket="${runtime_dir%/}/$WAYLAND_DISPLAY"
    local wslg_socket="/mnt/wslg/runtime-dir/$WAYLAND_DISPLAY"
    if [[ -e "$wayland_socket" && ! -S "$wayland_socket" ]]; then
      rm -f "$wayland_socket"
    fi
    if [[ ! -S "$wayland_socket" && -S "$wslg_socket" ]]; then
      if [[ ! -d "$runtime_dir" ]]; then
        if ! mkdir -p "$runtime_dir" 2>/dev/null; then
          [[ -t 0 ]] || die "cannot create Wayland runtime directory: $runtime_dir"
          step "restore Wayland runtime directory" "$runtime_dir (sudo)"
          sudo install -d -m 0700 -o "$(id -u)" -g "$(id -g)" "$runtime_dir" \
            || die "cannot create Wayland runtime directory: $runtime_dir"
        fi
      fi
      ln -sfn "$wslg_socket" "$wayland_socket"
    fi
  fi

  local container=""
  container="$(find_devcontainer_container)"
  if [[ -n "$container" ]]; then
    if ! docker ps --format '{{.Names}}' | grep -Fxq "$container"; then
      step "starting existing devcontainer" "$container"
      if ! docker start "$container" 2>&1 | tee "$startup_log_host" >&2; then
        die "failed to start devcontainer $container"
      fi
      run_post_start_command "$container"
    fi
    printf '%s\n' "$container"
    return 0
  fi

  step "creating devcontainer" "$root"
  local dc_cmd
  dc_cmd="$(devcontainer_cmd)"
  script -qefc "$dc_cmd up --workspace-folder $(quote "$root")" /dev/null 2>&1 | tee "$startup_log_host" >&2

  container="$(find_devcontainer_container)"
  [[ -n "$container" ]] || die "devcontainer started, but no matching running container was found"
  printf '%s\n' "$container"
}

run_post_start_command() {
  local container="$1" post_start remote_user workspace
  post_start="$(devcontainer_json_value postStartCommand || true)"
  [[ -n "$post_start" ]] || return 0

  remote_user="$(devcontainer_json_value remoteUser || true)"
  [[ -n "$remote_user" ]] || remote_user="$(docker inspect -f '{{.Config.User}}' "$container" 2>/dev/null || true)"
  [[ -n "$remote_user" ]] || remote_user=root

  workspace="$(container_workspace "$container")"
  step "postStartCommand" "devcontainer.json"
  docker exec -u "$remote_user" -w "$workspace" "$container" sh -lc "$post_start" 2>&1 | tee -a "$startup_log_host" >&2
}

copy_startup_log_to_container() {
  local container="$1" root_name remote_log
  root_name="$(basename "$root")"
  remote_log="/tmp/nvim-dev-$root_name-startup.log"

  [[ -s "$startup_log_host" ]] || return 0
  docker cp "$startup_log_host" "$container:$remote_log" >/dev/null 2>&1 || return 0
}

bootstrap_and_start_server() {
  local container="$1" workspace="$2" port="$3" root_name
  root_name="$(basename "$root")"

  local host_state_file="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/clangd_build_dirs.json"
  local host_build_dir=""
  local remote_build_dir=""
  if [[ -f "$host_state_file" ]]; then
    host_build_dir="$(python3 - "$host_state_file" "$root" <<'PY' 2>/dev/null || true
import json, sys
try:
    data = json.load(open(sys.argv[1], 'r', encoding='utf-8'))
    print(data.get(sys.argv[2], ''))
except Exception:
    pass
PY
)"
  fi
  if [[ -n "$host_build_dir" ]]; then
    case "$host_build_dir" in
      "$root"/*) remote_build_dir="$workspace/${host_build_dir#"$root"/}" ;;
    esac
  fi

  local script
  script="set -e
export DEVCONTAINER=true
export NVIM_DEV_HOST_ROOT=$(quote "$root")
export NVIM_DEV_CONTAINER_WORKSPACE=$(quote "$workspace")
export OPENCODE_SERVER_URL=$(quote "${OPENCODE_SERVER_URL:-http://127.0.0.1:4096}")
if [ -n $(quote "$remote_build_dir") ] && [ -f $(quote "$remote_build_dir/compile_commands.json") ]; then
  export NVIM_CLANGD_COMPILE_COMMANDS_DIR=$(quote "$remote_build_dir")
fi
if ! command -v nvim >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1; then SUDO=sudo; else SUDO=; fi
    \$SUDO apt-get update || true
    \$SUDO apt-get install -y software-properties-common curl git ripgrep fd-find python3 python3-pip nodejs npm gdb || true
    \$SUDO add-apt-repository -y ppa:neovim-ppa/unstable >/dev/null 2>&1 || true
    \$SUDO apt-get update || true
    \$SUDO apt-get install -y neovim || true
  elif command -v apk >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1; then sudo apk add --no-cache neovim git ripgrep fd python3 nodejs npm gdb; else apk add --no-cache neovim git ripgrep fd python3 nodejs npm gdb; fi
  elif command -v dnf >/dev/null 2>&1; then
    if command -v sudo >/dev/null 2>&1; then sudo dnf install -y neovim git ripgrep fd-find python3 nodejs npm gdb; else dnf install -y neovim git ripgrep fd-find python3 nodejs npm gdb; fi
  fi
fi
command -v nvim >/dev/null 2>&1 || { echo 'nvim is not installed in this container' >&2; exit 127; }
mkdir -p \"\${XDG_CONFIG_HOME:-\$HOME/.config}\"
config_dir="\${XDG_CONFIG_HOME:-\$HOME/.config}/nvim"
data_dir="\${XDG_DATA_HOME:-\$HOME/.local/share}/nvim"
state_dir="\${XDG_STATE_HOME:-\$HOME/.local/state}/nvim"
mkdir -p "\$data_dir" "\$state_dir"
lock_file="\$config_dir/lazy-lock.json"
hash_file="\$state_dir/nvim-dev-lazy-lock.sha256"
current_hash_file="\$state_dir/nvim-dev-lazy-lock.current.sha256"
if [ -f "\$lock_file" ] && command -v sha256sum >/dev/null 2>&1; then
  sha256sum "\$lock_file" > "\$current_hash_file"
fi
if [ "\${NVIM_DEV_SYNC_PLUGINS:-auto}" = always ] || [ ! -d "\$data_dir/lazy/lazy.nvim" ] || { [ -f "\$current_hash_file" ] && ! cmp -s "\$current_hash_file" "\$hash_file"; }; then
  nvim --headless '+Lazy! sync' '+qa' || true
  if [ -f "\$current_hash_file" ]; then mv "\$current_hash_file" "\$hash_file"; fi
fi
workspace=$(quote "$workspace")
if [ ! -d \"\$workspace\" ]; then workspace=/workspaces/$(quote "$root_name"); fi
if [ ! -d \"\$workspace\" ]; then workspace=/workspace/$(quote "$root_name"); fi
if [ ! -d \"\$workspace\" ]; then workspace=\$PWD; fi
cd \"\$workspace\"
printf '%s\n' $(quote "$port") > /tmp/$(quote "nvim-dev-$root_name.port")
export NVIM_DEV_REMOTE=1
export NVIM_DEV_WORKSPACE=$(quote "$workspace")
exec nvim --listen 0.0.0.0:$port --headless"

  docker exec -d "$container" sh -lc "$script" >/dev/null
}

running_server_port() {
  local container="$1" root_name
  root_name="$(basename "$root")"

  docker exec "$container" sh -lc "
file=/tmp/$(quote "nvim-dev-$root_name.port")
[ -f \"\$file\" ] || exit 0
port=\$(cat \"\$file\" 2>/dev/null || true)
case \"\$port\" in ''|*[!0-9]*) exit 0 ;; esac
if command -v timeout >/dev/null 2>&1; then
  timeout 2s nvim --server 127.0.0.1:\$port --remote-expr 1 >/dev/null 2>&1
else
  nvim --server 127.0.0.1:\$port --remote-expr 1 >/dev/null 2>&1
fi
if [ \$? -eq 0 ]; then
  printf '%s\n' \"\$port\"
fi
" 2>/dev/null || true
}

sync_nvim_config_to_container() {
  local container="$1" start config_hash remote_hash
  start=$SECONDS
  step "sync config" "host → container"

  if [[ ! -d "$HOME/.config/nvim" ]]; then
    die "host nvim config not found at $HOME/.config/nvim"
  fi

  config_hash="$(tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner --exclude=nvim/.git -C "$HOME/.config" -cf - nvim | sha256sum | cut -d ' ' -f 1)"

  IFS='|' read -r user_id group_id config_dir remote_hash < <(
    docker exec "$container" sh -lc '
      uid=$(id -u)
      gid=$(id -g)
      cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
      rh=$(cat "$cfg/.nvim-config.sha256" 2>/dev/null || true)
      printf "%s|%s|%s|%s\n" "$uid" "$gid" "$cfg" "$rh"
    '
  ) || die "failed to read container metadata"

  if [[ -n "$config_hash" && "$config_hash" == "$remote_hash" ]]; then
    ok "config unchanged" "$((SECONDS - start))s"
    return 0
  fi

  docker exec -u root "$container" sh -lc "
    rm -rf $(quote "$config_dir/nvim") && mkdir -p $(quote "$config_dir")
  " || die "failed to prepare container nvim config dir"
  tar --exclude=nvim/.git -C "$HOME/.config" -cf - nvim \
    | docker exec -i -u root "$container" sh -lc "tar -C $(quote "$config_dir") -xf -" \
    || die "failed to sync nvim config to container"
  docker exec -u root "$container" sh -lc "
    printf '%s\n' $(quote "$config_hash") > $(quote "$config_dir/.nvim-config.sha256")
    mkdir -p $(quote "$config_dir/clangd")
    chown -R $(quote "$user_id:$group_id") $(quote "$config_dir/nvim") $(quote "$config_dir/clangd") $(quote "$config_dir/.nvim-config.sha256")
  " || true
  printf '%s\n' "$config_hash" > "$HOME/.config/nvim/.nvim-config.sha256"
  ok "config synced" "$((SECONDS - start))s"
}

ensure_container_tools() {
  local container="$1" start config_hash check_out
  start=$SECONDS
  step "check tools" "nvim git rg fzf bat clang-format lazygit yazi chafa pdftoppm PyYAML"

  config_hash="$(tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner --exclude=nvim/.git -C "$HOME/.config" -cf - nvim 2>/dev/null | sha256sum | cut -d ' ' -f 1 || true)"

  check_out="$(docker exec "$container" sh -lc "
    set -e
    cfg=\"\${XDG_CONFIG_HOME:-\$HOME/.config}\"
    tag_file=\"\$cfg/nvim/.nvim-tools.ok\"
    if [ -f \"\$tag_file\" ] \
      && [ \"\$(cat \"\$tag_file\" 2>/dev/null || true)\" = $(quote "$config_hash") ] \
      && nvim --version >/dev/null 2>&1 \
      && lazygit --version >/dev/null 2>&1 \
      && (command -v bat >/dev/null 2>&1 || command -v batcat >/dev/null 2>&1) \
      && chafa --version >/dev/null 2>&1 \
      && pdftoppm -v >/dev/null 2>&1 \
      && yazi --version >/dev/null 2>&1; then
      printf '%s\n' cached
    else
      printf '%s\n' \"\$cfg\"
    fi
  " 2>/dev/null || true)"

  if [[ "$check_out" == "cached" ]]; then
    ok "tools ready" "$((SECONDS - start))s"
    return 0
  fi
  local config_dir="$check_out"

  docker exec -u root "$container" sh -lc '
set -e
for cmd in nvim git rg fzf curl tar unzip clang-format lazygit yazi gdb chafa pdftoppm; do
  command -v "$cmd" >/dev/null 2>&1 || { missing=1; break; }
done
{ command -v bat >/dev/null 2>&1 || command -v batcat >/dev/null 2>&1; } || missing=1
yazi --version >/dev/null 2>&1 || missing=1
python3 - <<'PY' >/dev/null 2>&1 || missing=1
import yaml
PY
if [ -n "${missing:-}" ]; then
  if command -v apt-get >/dev/null 2>&1; then
    rm -f /etc/apt/sources.list.d/lazygit-team-ubuntu-release-*.list /etc/apt/sources.list.d/lazygit-team-ubuntu-release-*.sources
    apt-get update
    apt-get install -y software-properties-common curl git ripgrep fd-find fzf bat tar unzip python3 python3-pip python3-yaml clang-format gdb chafa poppler-utils
    command -v bat >/dev/null 2>&1 || ln -sf "$(command -v batcat)" /usr/local/bin/bat
    if ! command -v lazygit >/dev/null 2>&1; then
      arch="$(uname -m)"
      case "$arch" in
        x86_64|amd64) asset_arch=x86_64 ;;
        aarch64|arm64) asset_arch=arm64 ;;
        *) asset_arch= ;;
      esac
      if [ -n "$asset_arch" ]; then
        version="$(python3 -c "import json, urllib.request; r=urllib.request.urlopen(\"https://api.github.com/repos/jesseduffield/lazygit/releases/latest\", timeout=20); print(json.load(r).get(\"tag_name\", \"\").lstrip(\"v\"))")"
        tmp="$(mktemp -d)"
        curl -fsSL -o "$tmp/lazygit.tar.gz" "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${version}_Linux_${asset_arch}.tar.gz"
        tar -C "$tmp" -xf "$tmp/lazygit.tar.gz" lazygit
        install -m 0755 "$tmp/lazygit" /usr/local/bin/lazygit
        rm -rf "$tmp"
      fi
    fi
    if ! yazi --version >/dev/null 2>&1; then
      arch="$(uname -m)"
      case "$arch" in
        x86_64|amd64) target=x86_64-unknown-linux-musl ;;
        aarch64|arm64) target=aarch64-unknown-linux-musl ;;
        *) target= ;;
      esac
      if [ -n "$target" ]; then
        tmp="$(mktemp -d)"
        curl -fsSL -o "$tmp/yazi.zip" "https://github.com/sxyazi/yazi/releases/latest/download/yazi-${target}.zip"
        unzip -q "$tmp/yazi.zip" -d "$tmp"
        install -m 0755 "$tmp/yazi-${target}/yazi" "$tmp/yazi-${target}/ya" /usr/local/bin/
        rm -rf "$tmp"
      fi
    fi
    if ! command -v nvim >/dev/null 2>&1; then
      add-apt-repository -y ppa:neovim-ppa/unstable >/dev/null 2>&1 || true
      apt-get update
      apt-get install -y neovim
    fi
  elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache neovim git ripgrep fd fzf curl tar python3 py3-yaml nodejs npm clang-extra-tools gdb chafa poppler-utils || true
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y neovim git ripgrep fd-find fzf curl tar python3 python3-pyyaml nodejs npm clang-tools-extra gdb chafa poppler-utils || true
  fi
fi
' || die "failed to ensure required tools in container"

  if [[ -n "$config_hash" && -n "$config_dir" ]]; then
    docker exec -u root "$container" sh -lc "
      mkdir -p $config_dir/nvim
      printf '%s\n' $(quote "$config_hash") > $config_dir/nvim/.nvim-tools.ok
    " 2>/dev/null || true
  fi
  ok "tools ready" "$((SECONDS - start))s"
}

ensure_container_git_forge() {
  local container="$1" remote_user remote_home answer remote_url remote_host cli forge
  remote_user="$(devcontainer_json_value remoteUser || true)"
  [[ -n "$remote_user" ]] || remote_user="$(docker inspect -f '{{.Config.User}}' "$container" 2>/dev/null || true)"
  [[ -n "$remote_user" ]] || remote_user=root

  remote_url="$(git -C "$root" remote get-url origin 2>/dev/null || true)"
  remote_host="$(printf '%s\n' "$remote_url" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://([^/@]+@)?([^/:]+).*#\2#; t; s#^([^@]+@)?([^:]+):.*#\2#')"
  [[ -n "$remote_host" ]] || return 0

  if [[ "$remote_host" == github.com ]]; then
    cli=gh
    forge=GitHub
  elif command -v glab >/dev/null 2>&1 && glab auth status --hostname "$remote_host" >/dev/null 2>&1; then
    cli=glab
    forge=GitLab
  else
    return 0
  fi

  if ! docker exec -u "$remote_user" "$container" sh -lc "command -v $cli >/dev/null 2>&1" >/dev/null 2>&1; then
    [[ -t 0 && -t 1 ]] || { warn "$forge CLI missing in container" "install $cli in the devcontainer"; return 0; }
    printf '%b' "${c_blue}?${c_reset} Install $forge CLI in the devcontainer? [y/N] " >&2
    read -r answer
    case "${answer,,}" in
      y|yes)
        if [[ "$cli" == glab ]]; then
          docker cp "$(command -v glab)" "$container:/usr/local/bin/glab" >/dev/null \
            && docker exec -u root "$container" chmod 0755 /usr/local/bin/glab \
            || { warn "$forge CLI install failed" "install $cli in the devcontainer manually"; return 0; }
        else
          docker exec -u root "$container" sh -lc 'apt-get update && apt-get install -y gh' \
            || { warn "$forge CLI install failed" "install $cli in the devcontainer manually"; return 0; }
        fi
        ok "$forge CLI installed" "$cli"
        ;;
      *)
        warn "$forge CLI skipped" "install $cli in the devcontainer manually"
        return 0
        ;;
    esac
  fi

  if [[ "$cli" == glab ]]; then
    remote_home="$(docker exec -u "$remote_user" "$container" sh -lc 'printf %s "$HOME"')"
    docker exec -u root "$container" sh -lc "
      mkdir -p $(quote "$remote_home/.config/glab-cli")
      chown -R \$(id -u $(quote "$remote_user")):$(docker exec "$container" id -g "$remote_user") $(quote "$remote_home/.config/glab-cli")
    " || { warn "$forge CLI setup failed" "prepare $remote_home/.config/glab-cli manually"; return 0; }
  fi

  if docker exec -u "$remote_user" "$container" "$cli" auth status --hostname "$remote_host" >/dev/null 2>&1; then
    if [[ "$cli" == glab ]]; then
      docker exec -u "$remote_user" "$container" git config --global "credential.https://$remote_host.helper" '!glab auth git-credential'
    fi
    ok "$forge CLI authenticated" "container user $remote_user"
    return 0
  fi

  [[ -t 0 && -t 1 ]] || { warn "$forge CLI not authenticated" "run $cli auth login --hostname $remote_host in the devcontainer"; return 0; }
  printf '%b' "${c_blue}?${c_reset} Run $cli auth login for $remote_host in the devcontainer now? [y/N] " >&2
  read -r answer
  case "${answer,,}" in
    y|yes)
      docker exec -it -u "$remote_user" "$container" "$cli" auth login --hostname "$remote_host"
      if [[ "$cli" == glab ]]; then
        docker exec -u "$remote_user" "$container" git config --global "credential.https://$remote_host.helper" '!glab auth git-credential'
      fi
      ;;
    *) warn "$forge authentication skipped" "run $cli auth login --hostname $remote_host in the devcontainer manually" ;;
  esac
}

wait_for_server() {
  local addr="$1"
  local i spin elapsed
  local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
  for i in $(seq 1 100); do
    if nvim_remote_expr "$addr" 1; then
      if [[ -t 2 ]]; then
        printf '\r\033[K' >&2
      fi
      ok "server online" "$addr"
      return 0
    fi
    if [[ -t 2 ]]; then
      spin="${frames[$(((i - 1) % ${#frames[@]}))]}"
      elapsed=$((i / 10))
      printf '\r%b %bwaiting for nvim server%b %s %bs%b' "${c_yellow}${spin}${c_reset}" "${c_bold}" "${c_reset}" "$addr" "${c_dim}${elapsed}" "${c_reset}" >&2
    fi
    sleep 0.1
  done
  if [[ -t 2 ]]; then
    printf '\r\033[K' >&2
  fi
  return 1
}

need docker
install_host_wrappers
nvim_bin="$(real_nvim)" || die "real nvim binary not found"
banner

# Devcontainer bind mounts must exist before Docker creates the container.
mkdir -p "$HOME/.ssh" "$HOME/.config/gh"
chmod 700 "$HOME/.ssh"

root="$(project_root)"
if ! has_devcontainer; then
  info "no devcontainer found" "opening local nvim"
  exec "$nvim_bin" "$root"
fi

root_name="$(basename "$root")"
startup_log_host="${XDG_STATE_HOME:-$HOME/.local/state}/nvim/nvim-dev-$root_name-startup.log"
mkdir -p "$(dirname "$startup_log_host")"
rm -f "$startup_log_host"

action="${NVIM_DEV_ACTION:-attach}"
container="${NVIM_DEV_CONTAINER:-}"

case "$action" in
  attach)
    container="${container:-$(ensure_devcontainer_running)}"
    ;;
  up|reopen)
    dc_cmd="$(devcontainer_cmd)"
    script -qefc "$dc_cmd up --workspace-folder $(quote "$root")" /dev/null 2>&1 | tee "$startup_log_host"
    container="${container:-$(find_devcontainer_container)}"
    [[ -n "$container" ]] || container="$(choose_container)"
    ;;
  rebuild)
    dc_cmd="$(devcontainer_cmd)"
    script -qefc "$dc_cmd up --workspace-folder $(quote "$root") --remove-existing-container" /dev/null 2>&1 | tee "$startup_log_host"
    container="${container:-$(find_devcontainer_container)}"
    [[ -n "$container" ]] || container="$(choose_container)"
    ;;
  *)
    die "unknown NVIM_DEV_ACTION: $action"
    ;;
esac

workspace="$(container_workspace "$container")"
host="$(container_host "$container")"
existing_port="$(running_server_port "$container")"
port="${NVIM_DEV_PORT:-$existing_port}"
if [[ -z "$port" ]]; then
  port="$((41000 + RANDOM % 10000))"
fi
addr="$host:$port"

sync_nvim_config_to_container "$container"
ensure_container_tools "$container"
ensure_container_git_forge "$container"
copy_startup_log_to_container "$container"

info "container" "$container"
info "workspace" "$workspace"
info "server" "$addr"
if [[ -n "$existing_port" && "$existing_port" == "$port" ]]; then
  ok "reuse server" "$addr"
else
  step "start server" "$addr"
  bootstrap_and_start_server "$container" "$workspace" "$port"
fi
wait_for_server "$addr" || die "timed out waiting for container nvim server at $addr"
ok "attach remote UI"

windows_download_dir() {
  if [[ -n "${NVIM_WINDOWS_DOWNLOAD_DIR:-}" ]]; then
    printf '%s\n' "$NVIM_WINDOWS_DOWNLOAD_DIR"
    return
  fi
  command -v powershell.exe >/dev/null 2>&1 || return 1
  command -v wslpath >/dev/null 2>&1 || return 1

  local profile
  profile="$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("UserProfile")' | tr -d '\r')"
  [[ -n "$profile" ]] || return 1
  wslpath -u "$profile\\Downloads"
}

download_bridge() {
  local parent_pid="$1" request_dir="$root/.git/nvim-download" target_dir request processing response source_file host_file windows_path name stem ext candidate index
  target_dir="$(windows_download_dir)" || return 0
  mkdir -p "$request_dir" "$target_dir"

  while kill -0 "$parent_pid" 2>/dev/null; do
    for request in "$request_dir"/*.request; do
      [[ -f "$request" ]] || continue
      processing="${request%.request}.processing.$$"
      mv "$request" "$processing" 2>/dev/null || continue
      source_file="$(cat "$processing")"
      response="${request%.request}.response"
      if ! docker exec "$container" test -f "$source_file" 2>/dev/null; then
        printf 'ERROR:Selected file no longer exists\n' > "$response"
        rm -f "$processing"
        continue
      fi

      name="$(basename "$source_file")"
      candidate="$target_dir/$name"
      if [[ -e "$candidate" ]]; then
        stem="$name"
        ext=""
        if [[ "$name" == *.* && "$name" != .* ]]; then
          stem="${name%.*}"
          ext=".${name##*.}"
        fi
        index=1
        while [[ -e "$target_dir/$stem ($index)$ext" ]]; do index=$((index + 1)); done
        candidate="$target_dir/$stem ($index)$ext"
      fi

      if docker cp "$container:$source_file" "$candidate" >/dev/null 2>&1; then
        printf '%s\n' "$candidate" > "$response"
      else
        printf 'ERROR:Could not copy file from devcontainer\n' > "$response"
      fi
      rm -f "$processing"
    done

    for request in "$request_dir"/*.open-request; do
      [[ -f "$request" ]] || continue
      processing="${request%.open-request}.open-processing.$$"
      mv "$request" "$processing" 2>/dev/null || continue
      source_file="$(cat "$processing")"
      response="${request%.open-request}.open-response"
      case "$source_file" in
        "$workspace"/*) host_file="$root/${source_file#"$workspace"/}" ;;
        *)
          printf 'ERROR:Only files inside the devcontainer workspace can be opened on Windows\n' > "$response"
          rm -f "$processing"
          continue
          ;;
      esac

      if [[ ! -f "$host_file" ]]; then
        printf 'ERROR:Selected file is not visible in the WSL workspace\n' > "$response"
      elif ! windows_path="$(wslpath -w "$host_file")"; then
        printf 'ERROR:Could not translate the file path for Windows\n' > "$response"
      elif NVIM_OPEN_FILE="$windows_path" \
        WSLENV="${WSLENV:+$WSLENV:}NVIM_OPEN_FILE" \
        powershell.exe -NoProfile -Command 'Invoke-Item -LiteralPath $env:NVIM_OPEN_FILE' >/dev/null 2>&1; then
        printf 'OK\n' > "$response"
      else
        printf 'ERROR:Windows could not open the selected file\n' > "$response"
      fi
      rm -f "$processing"
    done
    sleep 0.1
  done
}

download_bridge "$$" &

exec "$nvim_bin" --server "$addr" --remote-ui
