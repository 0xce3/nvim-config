#!/usr/bin/env python3
"""Manage editor, Bash, and task windows in the selected runtime environment."""

import argparse
import hashlib
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path


def tmux(*args, check=True):
    return subprocess.run(["tmux", *args], check=check, text=True, capture_output=True)


def shell_command(args):
    return shlex.join([str(arg) for arg in args])


def configure_window(target):
    for option, value in (
        ("automatic-rename", "off"),
        ("allow-rename", "off"),
        ("window-status-format", " #I:#W "),
        ("window-status-current-format", " #I:#W "),
        ("window-status-current-style", "bg=#504945,fg=#ebdbb2,bold"),
    ):
        tmux("set-window-option", "-t", target, option, value)
    name = tmux("display-message", "-p", "-t", target, "#{window_name}").stdout.strip()
    scrolling = name in ("bash", "tasks")
    tmux(
        "set-window-option",
        "-t",
        target,
        "pane-scrollbars",
        "on" if scrolling else "off",
    )
    if scrolling:
        tmux("set-window-option", "-t", target, "pane-scrollbars-position", "right")
        tmux(
            "set-window-option",
            "-t",
            target,
            "pane-scrollbars-style",
            "bg=#3c3836,fg=#a89984,width=1,pad=0",
        )


def configure_keys():
    # Windows Terminal sends Ctrl+digits as distinct CSI-u key sequences.
    tmux("unbind-key", "-n", "C-0")
    for index in range(1, 10):
        tmux("bind-key", "-n", f"C-{index}", "select-window", "-t", f":{index}")

    bash_window = "#{==:#{window_name},bash}"
    scroll_window = "#{||:" + bash_window + ",#{==:#{window_name},tasks}}"
    tmux(
        "bind-key",
        "-n",
        "PPage",
        "if-shell",
        "-F",
        scroll_window,
        "copy-mode -u",
        "send-keys PPage",
    )
    # At the live prompt there is no newer scrollback to show. Do not send
    # PageDown to Readline, where it may be bound to next-history.
    tmux(
        "bind-key",
        "-n",
        "NPage",
        "if-shell",
        "-F",
        "#{!:" + scroll_window + "}",
        "send-keys NPage",
    )
    for table in ("copy-mode", "copy-mode-vi"):
        tmux("bind-key", "-T", table, "PPage", "send-keys", "-X", "page-up")
        bottom = "#{&&:" + scroll_window + ",#{==:#{scroll_position},0}}"
        tmux(
            "bind-key",
            "-T",
            table,
            "NPage",
            "send-keys -X page-down ; if-shell -F "
            + shlex.quote(bottom)
            + " 'copy-mode -q'",
        )
        tmux(
            "bind-key",
            "-T",
            table,
            "WheelDownPane",
            "select-pane -t = ; send-keys -X -N 3 scroll-down ; if-shell -F "
            + shlex.quote(bottom)
            + " 'copy-mode -q'",
        )
        for key, motion in (("Up", "cursor-up"), ("Down", "cursor-down")):
            tmux(
                "bind-key",
                "-T",
                table,
                key,
                "if-shell",
                "-F",
                bash_window,
                f"send-keys -X cancel ; send-keys {key}",
                f"send-keys -X {motion}",
            )


def configure_lifecycle(session):
    # The editor owns the workspace. Its exit closes Bash and task panes too.
    tmux("set-window-option", "-t", f"{session}:1", "remain-on-exit", "on")
    tmux(
        "set-hook",
        "-t",
        session,
        "pane-died",
        "if-shell -F '#{==:#{window_index},1}' "
        + shlex.quote("kill-session -t =" + session),
    )
    # Enable this only after attachment: creation initially happens detached.
    tmux(
        "set-hook",
        "-t",
        session,
        "client-attached",
        "set-option -t " + session + " destroy-unattached on",
    )


def launch(target):
    root = Path(target).resolve()
    session = "nvim-" + hashlib.sha256(str(root).encode()).hexdigest()[:12]
    directory = (
        Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
        / "nvim/tmux"
        / session
    )
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    if os.environ.get("NVIM_TMUX_BRIDGE_DIR"):
        directory = Path(os.environ["NVIM_TMUX_BRIDGE_DIR"])
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    helper = Path(__file__).resolve()
    wrapper = Path.home() / ".config/nvim/bin/nvim"
    command = (
        'while [ "$(tmux show-option -qv -t '
        + shlex.quote(session)
        + ' @nvim_ready)" != 1 ]; do sleep 0.1; done; '
        + shell_command(
            [
                sys.executable,
                helper,
                "bridge",
                "--session",
                session,
                "--directory",
                directory,
                "--workspace",
                root,
            ]
        )
        + " --parent $$ & exec env TERM=tmux-256color COLORTERM=truecolor "
        + (
            os.environ.get("NVIM_TMUX_EDITOR_COMMAND")
            or shell_command(
                [
                    "env",
                    "NVIM_TMUX_LAUNCHED=1",
                    f"NVIM_TMUX_SESSION={session}",
                    f"NVIM_TMUX_BRIDGE_DIR={directory}",
                    wrapper,
                    root,
                ]
            )
        )
    )
    if tmux("has-session", "-t", "=" + session, check=False).returncode:
        tmux("new-session", "-d", "-s", session, "-n", "nvim", "-c", str(root), command)
        # Preserve truecolor when tmux becomes the terminal seen by Neovim.
        tmux(
            "set-option",
            "-s",
            "-a",
            "terminal-overrides",
            ",xterm:Tc,xterm-256color:Tc,tmux-256color:Tc",
        )
        tmux("set-option", "-g", "default-terminal", "tmux-256color")
        tmux("set-option", "-t", session, "renumber-windows", "off")
        # Explicit targets also work with a different user-configured base index.
        index = tmux(
            "display-message", "-p", "-t", session, "#{window_index}"
        ).stdout.strip()
        if index != "1":
            tmux("move-window", "-s", f"{session}:{index}", "-t", f"{session}:1")
        tmux("set-option", "-t", session, "base-index", "1")
        tmux("set-option", "-t", session, "history-limit", "50000")
        tmux("set-option", "-t", session, "renumber-windows", "off")
        tmux("set-option", "-t", session, "status", "on")
        tmux("set-option", "-t", session, "status-position", "top")
        tmux("set-option", "-t", session, "status-left", "")
        tmux("set-option", "-t", session, "status-right", "")
        tmux("set-option", "-t", session, "status-justify", "left")
        tmux("set-window-option", "-t", session, "window-status-format", " #I:#W ")
        tmux(
            "set-window-option",
            "-t",
            session,
            "window-status-current-format",
            " #I:#W ",
        )
        tmux("set-option", "-t", session, "status-style", "bg=#282828,fg=#a89984")
        tmux(
            "set-window-option",
            "-t",
            session,
            "window-status-current-style",
            "bg=#504945,fg=#ebdbb2,bold",
        )
        tmux("set-window-option", "-t", f"{session}:1", "automatic-rename", "off")
        tmux("set-window-option", "-t", f"{session}:1", "allow-rename", "off")
        tmux(
            "new-window",
            "-d",
            "-t",
            f"{session}:2",
            "-n",
            "bash",
            "-c",
            str(root),
            "bash -il",
        )
        tmux("set-window-option", "-t", f"{session}:2", "automatic-rename", "off")
        tmux("set-window-option", "-t", f"{session}:2", "allow-rename", "off")
        tmux("select-window", "-t", f"{session}:1")
        configure_lifecycle(session)
        tmux("set-option", "-t", session, "@nvim_ready", "1")
    else:
        windows = tmux(
            "list-windows", "-t", session, "-F", "#{window_index}"
        ).stdout.splitlines()
        if "0" in windows:
            # Preserve a workspace created with the previous numbering scheme.
            if "1" in windows:
                tmux("move-window", "-s", f"{session}:1", "-t", f"{session}:2")
            tmux("move-window", "-s", f"{session}:0", "-t", f"{session}:1")
            windows = tmux(
                "list-windows", "-t", session, "-F", "#{window_index}"
            ).stdout.splitlines()
        tmux("set-option", "-t", session, "base-index", "1")
        if "1" not in windows:
            tmux(
                "new-window",
                "-d",
                "-t",
                f"{session}:1",
                "-n",
                "nvim",
                "-c",
                str(root),
                command,
            )
            tmux("set-window-option", "-t", f"{session}:1", "automatic-rename", "off")
            tmux("set-window-option", "-t", f"{session}:1", "allow-rename", "off")
        if "2" not in windows:
            tmux(
                "new-window",
                "-d",
                "-t",
                f"{session}:2",
                "-n",
                "bash",
                "-c",
                str(root),
                "bash -il",
            )
            tmux("set-window-option", "-t", f"{session}:2", "automatic-rename", "off")
            tmux("set-window-option", "-t", f"{session}:2", "allow-rename", "off")
        tmux("select-window", "-t", f"{session}:1")
        configure_lifecycle(session)
    tmux("set-option", "-t", session, "mouse", "on")
    tmux("set-option", "-t", session, "history-limit", "50000")
    for index in tmux(
        "list-windows", "-t", session, "-F", "#{window_index}"
    ).stdout.splitlines():
        configure_window(f"{session}:{index}")
    configure_keys()
    if os.environ.get("TMUX"):
        tmux("switch-client", "-t", session)
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", session])


def bridge(args):
    directory = Path(args.directory)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)

    running_result = None
    while tmux("has-session", "-t", "=" + args.session, check=False).returncode == 0:
        if args.parent:
            try:
                os.kill(args.parent, 0)
            except ProcessLookupError:
                return
        (directory / "heartbeat").touch()
        for request in sorted(directory.glob("*.request")):
            response = request.with_suffix(".response")
            try:
                data = json.loads(request.read_text())
                action = data["action"]
                if action == "select":
                    tmux("select-window", "-t", f"{args.session}:{int(data['window'])}")
                elif action == "stop":
                    tmux("send-keys", "-t", f"{args.session}:3", "C-c")
                elif action == "task":
                    if running_result is not None and not running_result.exists():
                        raise ValueError("A task is already running in tmux window 3")
                    if running_result is not None:
                        running_result.unlink(missing_ok=True)
                    script = request.with_suffix(".sh")
                    result = request.with_suffix(".result")
                    remote_script = str(script)
                    remote_result = str(result)
                    command = (
                        "#!/usr/bin/env bash\n"
                        + "trap ':' INT\n"
                        + "bash -lc "
                        + shlex.quote(data["command"])
                        + "\n"
                        + "task_exit=$?\n"
                        + "printf '%s\\n' \"$task_exit\" > "
                        + shlex.quote(remote_result)
                        + "\n"
                        + "printf '\\nTask finished (exit %s).\\n' \"$task_exit\"\n"
                        + "exec bash -il\n"
                    )
                    script.write_text(command)
                    cwd = data.get("cwd", args.workspace)
                    run = shell_command(
                        [
                            "bash",
                            "-ilc",
                            "cd "
                            + shlex.quote(cwd)
                            + " && exec bash "
                            + shlex.quote(remote_script),
                        ]
                    )
                    target = f"{args.session}:3"
                    # respawn-window has no detached flag and can select the
                    # target. Recreate it detached, including on later runs.
                    tmux(
                        "new-window",
                        "-d",
                        "-k",
                        "-t",
                        target,
                        "-n",
                        "tasks",
                        "-c",
                        args.workspace,
                        run,
                    )
                    tmux("rename-window", "-t", target, "tasks")
                    tmux("set-window-option", "-t", target, "automatic-rename", "off")
                    tmux("set-window-option", "-t", target, "allow-rename", "off")
                    configure_window(target)
                    running_result = result
                else:
                    raise ValueError(f"Unknown action: {action}")
                response.write_text("ok")
            except (
                OSError,
                ValueError,
                KeyError,
                subprocess.CalledProcessError,
            ) as error:
                response.write_text(str(error))
            finally:
                request.unlink(missing_ok=True)
        time.sleep(0.1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="action", required=True)
    start = subparsers.add_parser("launch")
    start.add_argument("target")
    subparsers.add_parser("configure-keys")
    serve = subparsers.add_parser("bridge")
    serve.add_argument("--session", required=True)
    serve.add_argument("--directory", required=True)
    serve.add_argument("--workspace", required=True)
    serve.add_argument("--parent", type=int)
    args = parser.parse_args()
    if args.action == "launch":
        launch(args.target)
    elif args.action == "bridge":
        bridge(args)
    else:
        configure_keys()


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"nvim-tmux: {error}", file=sys.stderr)
        sys.exit(1)
